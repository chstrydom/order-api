# Copy to .env (never commit .env). Values below match docker-compose.yml.
POSTGRES_PASSWORD=local_dev_password

# Used by the API and worker when run outside Docker (`uv run ...`).
DATABASE_URL=postgresql://order_api:local_dev_password@localhost:5432/order_api

# Used only by the tests. The database name MUST end in _test: the test suite
# truncates every table and refuses to run against any other database.
TEST_DATABASE_URL=postgresql://order_api:local_dev_password@localhost:5432/order_api_test

# Worker settings (optional).
WORKER_POLL_INTERVAL=1
# Creating this file pauses order processing (demo hook). The Docker worker
# mounts ./worker_pause, so this path works for both local and Docker runs.
WORKER_PAUSE_SENTINEL=worker_pause/.worker_paused
